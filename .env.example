# Скопіюйте у файл .env (він у .gitignore) і заповніть своїми значеннями

# Токен бота від @BotFather (обов'язково)
BOT_TOKEN=

# Стандартний режим: моніторинг світла через пристрій Tuya / Smart Life.
# Без цих двох ключів бот працює, але лише в розширеному режимі (моніторинг IP).
# Беруться на https://iot.tuya.com: Cloud -> Development -> ваш проєкт -> Overview
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Дата-центр проєкту. За замовчуванням Central Europe. Інші:
#   Western Europe  https://openapi-weaz.tuyaeu.com
#   Western America https://openapi.tuyaus.com
#   China           https://openapi.tuyacn.com
#   India           https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com

# Необов'язково
# Адреса, яка показується в стандартному режимі:
# TUYA_LOCATION=Богдана Хмельницького 67а
# Стежити лише за цими пристроями (Device ID через кому). Без цього - за всіма
# пристроями акаунта, прив'язаного до проєкту:
# TUYA_DEVICE_ID=
# Як часто питати Tuya про стан (секунди). Побачивши зміну, бот ще раз перевіряє стан
# через TUYA_PUSH_VERIFY_SECONDS і лише тоді сповіщає, тож сповіщення приходить через
# інтервал + ~15 с. Безкоштовна квота Tuya - 26 тис. запитів на місяць:
# 120 с ~ 22,3 тис., 180 с ~ 15 тис., 300 с ~ 9,4 тис.
# TUYA_POLL_SECONDS=120
# Пауза (секунди) і кількість підтверджень підряд для контрольної перевірки зміни:
# TUYA_PUSH_VERIFY_SECONDS=15
# TUYA_PUSH_CHECKS=1
# Push-канал Tuya вимкнено: для цього проєкту Tuya подій у нього не надсилає.
# Щоб спробувати (і побачити сирі повідомлення в логу), поставте 1:
# TUYA_PUSH=0
# TUYA_PUSH_LOG_RAW=1
# Розширений режим (моніторинг IP-адрес) вимкнено: код збережено, але користувачі до нього
# не потрапляють, вибору режиму немає. Щоб увімкнути знову: EXTENDED_MODE=1
# EXTENDED_MODE=0
# Розширений режим: як часто пінгувати IP-адреси (хвилини):
# IP_CHECK_MINUTES=10
